FROM emscripten/emsdk:latest AS wasm-builder
WORKDIR /build
COPY cubiomes/ ./cubiomes/
COPY seedviewer/wasm/ ./wasm/
RUN cd wasm && CUBIOMES_DIR=/build/cubiomes OUT_DIR=/build/wasm/out bash compile.sh

FROM node:22-slim AS builder
WORKDIR /app
COPY seedviewer/frontend/package.json seedviewer/frontend/package-lock.json* ./
RUN npm install
COPY seedviewer/frontend/ ./
COPY --from=wasm-builder /build/wasm/out/cubiomes.js ./public/cubiomes.js
COPY --from=wasm-builder /build/wasm/out/cubiomes.wasm ./public/cubiomes.wasm
RUN npm run build

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY seedviewer/frontend/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
